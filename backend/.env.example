# Copy to .env for local development. In Render, set these in the service's
# Environment tab instead of uploading a .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Comma-separated frontend origins. Use * to allow every origin.
CORS_ORIGINS=http://localhost:5173
